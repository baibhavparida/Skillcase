{
  "name": "skillcase-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.js",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run build && node --test tests/site.test.js",
    "cf:dev": "npm run build && wrangler dev --port 3000",
    "cf:publish": "wrangler deploy",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "images:optimize": "node scripts/optimize-images.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@phosphor-icons/web": "^2.1.2",
    "cobe": "^2.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.3",
    "wrangler": "^4.90.1"
  }
}
