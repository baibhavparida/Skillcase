---
const { active = "home" } = Astro.props;

const navItems = [
  { href: "/#jobs", label: "Candidate", key: "candidate" },
  { href: "/about/", label: "About Us", key: "about" },
  { href: "/blog/", label: "Blog", key: "blog" },
  { href: "/#faq", label: "FAQ", key: "faq" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Skillcase home">
    <img alt="Skillcase" class="brand-logo" src="/assets/images/SKILLCASE_logo.svg" />
  </a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {navItems.map((item) => (
      <a class:list={[active === item.key && "is-active"]} href={item.href}>{item.label}</a>
    ))}
  </nav>
  <div class="header-actions">
    <a class="btn btn-ghost btn-sm nav-login" href="/dashboard/nurse/">Login</a>
    <a class="btn btn-gold btn-sm nav-cta" href="/signup/">Get Started</a>
    <button
      aria-controls="mobile-navigation"
      aria-expanded="false"
      aria-label="Open navigation menu"
      class="mobile-menu-toggle"
      type="button"
    >
      <span class="hamburger-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
  <nav
    aria-label="Mobile navigation"
    class="mobile-nav-panel"
    hidden
    id="mobile-navigation"
  >
    <div class="mobile-nav-links">
      {navItems.map((item) => (
        <a href={item.href}>
          {item.label}
          <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
        </a>
      ))}
    </div>
    <div class="mobile-nav-actions">
      <a class="btn btn-outline btn-sm" href="/dashboard/nurse/">Login</a>
      <a class="btn btn-gold btn-sm" href="/signup/">Get Started</a>
    </div>
  </nav>
</header>
