---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProcessWorkspace from "../components/ProcessWorkspace";
import SearchTimeline from "../components/SearchTimeline";
---

<BaseLayout>
<div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="Skillcase home">
          <img alt="Skillcase" class="brand-logo" src="/assets/images/SKILLCASE_logo.svg" />
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="#jobs">Candidate</a>
          <a href="#process">About Us</a>
          <a href="#blogs">Blog</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="header-actions">
          <button class="btn btn-ghost btn-sm nav-login" type="button">Login</button>
          <button class="btn btn-gold btn-sm nav-cta" type="button">Get Started</button>
          <button
            aria-controls="mobile-navigation"
            aria-expanded="false"
            aria-label="Open navigation menu"
            class="mobile-menu-toggle"
            type="button"
          >
            <span class="hamburger-icon" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
          </button>
        </div>
        <nav
          aria-label="Mobile navigation"
          class="mobile-nav-panel"
          hidden
          id="mobile-navigation"
        >
          <div class="mobile-nav-links">
            <a href="#jobs">
              Candidate
              <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
            </a>
            <a href="#process">
              About Us
              <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
            </a>
            <a href="#blogs">
              Blog
              <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
            </a>
            <a href="#faq">
              FAQ
              <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
            </a>
          </div>
          <div class="mobile-nav-actions">
            <button class="btn btn-outline btn-sm" type="button">Login</button>
            <button class="btn btn-gold btn-sm" type="button">Get Started</button>
          </div>
        </nav>
      </header>

      <main>
        <section class="hero-section hero-background" id="top">
          <img
            alt="Indian nurse walking through Berlin in a Germany healthcare career setting"
            class="hero-bg-image"
            src="/assets/images/hero.webp"
          />
          <div class="hero-copy">
            <a class="webinar-pill" href="https://learner.skillcase.in/events/7cdknjvd">
              <span class="webinar-pill-icon" aria-hidden="true">
                <span data-icon="video" data-size="15"></span>
              </span>
              <span class="webinar-pill-copy">
                <span>Live webinar</span>
                <strong>Nursing jobs in Germany</strong>
              </span>
              <span class="webinar-pill-arrow" aria-hidden="true">
                <span data-icon="arrow-right" data-size="13"></span>
              </span>
            </a>
            <h1>Land your healthcare job in Germany</h1>
            <p>
              Discover exciting job openings abroad and get the expert help you need
              to navigate the entire process, from application to relocation.
            </p>
            <div class="hero-actions">
              <a class="btn btn-gold" href="#jobs">
                See Jobs
                <span data-icon="arrow-right" data-size="16" aria-hidden="true"></span>
              </a>
              <a class="btn btn-outline" href="https://learner.skillcase.in/events/7cdknjvd">
                Register Webinar
                <span data-icon="play" data-size="15" aria-hidden="true"></span>
              </a>
            </div>
          </div>
        </section>

        <section class="offer-strip" aria-label="Skillcase support services">
          <div class="offer-marquee">
            <div class="offer-marquee-track">
              <span class="offer-chip"><span data-icon="graduation-cap" data-size="15"></span>German language training</span>
              <span class="offer-chip"><span data-icon="shield-check" data-size="15"></span>Visa support</span>
              <span class="offer-chip"><span data-icon="badge-check" data-size="15"></span>Interview preparation</span>
              <span class="offer-chip"><span data-icon="file-check-2" data-size="15"></span>Documentation review</span>
              <span class="offer-chip"><span data-icon="clipboard-check" data-size="15"></span>Profile assessment</span>
              <span class="offer-chip"><span data-icon="heart-handshake" data-size="15"></span>Job matching</span>
              <span class="offer-chip"><span data-icon="briefcase-business" data-size="15"></span>CV guidance</span>
              <span class="offer-chip"><span data-icon="plane-takeoff" data-size="15"></span>Relocation planning</span>
              <span class="offer-chip"><span data-icon="stethoscope" data-size="15"></span>Employer coordination</span>
              <span class="offer-chip"><span data-icon="users-round" data-size="15"></span>Family settlement guidance</span>
              <span class="offer-chip"><span data-icon="graduation-cap" data-size="15"></span>German language training</span>
              <span class="offer-chip"><span data-icon="shield-check" data-size="15"></span>Visa support</span>
              <span class="offer-chip"><span data-icon="badge-check" data-size="15"></span>Interview preparation</span>
              <span class="offer-chip"><span data-icon="file-check-2" data-size="15"></span>Documentation review</span>
              <span class="offer-chip"><span data-icon="clipboard-check" data-size="15"></span>Profile assessment</span>
              <span class="offer-chip"><span data-icon="heart-handshake" data-size="15"></span>Job matching</span>
              <span class="offer-chip"><span data-icon="briefcase-business" data-size="15"></span>CV guidance</span>
              <span class="offer-chip"><span data-icon="plane-takeoff" data-size="15"></span>Relocation planning</span>
              <span class="offer-chip"><span data-icon="stethoscope" data-size="15"></span>Employer coordination</span>
              <span class="offer-chip"><span data-icon="users-round" data-size="15"></span>Family settlement guidance</span>
            </div>
          </div>
        </section>

        <section class="section metric-section">
          <section class="globe-feature">
            <div class="globe-card-header">
              <p class="eyebrow">Global opportunities</p>
              <h2>India's Healthcare Talent: Ready for Global Opportunities</h2>
            </div>
            <div class="globe-copy">
              <div class="opportunity-metrics">
                <article class="metric-card opportunity-metric">
                  <div class="metric-icon">
                    <span data-icon="users-round" data-size="16" aria-hidden="true"></span>
                  </div>
                  <span class="metric-label">Healthcare demand</span>
                  <strong>500,000 +</strong>
                  <p>Health professionals require in Germany by 2030</p>
                </article>
                <article class="metric-card opportunity-metric">
                  <div class="metric-icon">
                    <span data-icon="briefcase-business" data-size="16" aria-hidden="true"></span>
                  </div>
                  <span class="metric-label">Average gross salary</span>
                  <strong>₹3.2 - ₹3.8L</strong>
                  <p>Average gross salary for registered nurses in Germany</p>
                </article>
                <article class="metric-card opportunity-metric">
                  <div class="metric-icon">
                    <span data-icon="shield-check" data-size="16" aria-hidden="true"></span>
                  </div>
                  <span class="metric-label">Transparent support</span>
                  <strong>Free</strong>
                  <p>No agent or recruitment charges with fully transparency</p>
                </article>
              </div>
              <a class="btn btn-gold globe-action" href="#jobs">
                Create Profile
                <span data-icon="arrow-right" data-size="16" aria-hidden="true"></span>
              </a>
            </div>
            <div class="globe-stage" aria-label="Global healthcare routes from India">
              <div class="opportunity-cobe-globe" data-globe>
                <canvas></canvas>
                <div class="cobe-marker-label" data-marker="india">India<span aria-hidden="true"></span></div>
                <div class="cobe-marker-label" data-marker="germany">Germany<span aria-hidden="true"></span></div>
                <div class="cobe-marker-label" data-marker="japan">Japan<span aria-hidden="true"></span></div>
                <div class="cobe-marker-label" data-marker="uae">UAE<span aria-hidden="true"></span></div>
                <div class="cobe-marker-label" data-marker="uk">UK<span aria-hidden="true"></span></div>
                <div class="cobe-marker-label" data-marker="australia">Australia<span aria-hidden="true"></span></div>
              </div>
            </div>
          </section>
        </section>

        <section class="section benefits-section">
          <div class="section-heading">
            <p class="eyebrow">Why choose Skillcase</p>
            <h2>A practical move with long-term upside.</h2>
            <p>
              Explore the long-term benefits of working in Germany as a healthcare
              professional.
            </p>
          </div>
          <div class="benefit-grid">
            <article class="benefit-card benefit-card-earnings">
              <div class="benefit-copy">
                <h3>10x Your Earning Potential</h3>
                <p>
                  Earn Up to 10 Times More Than Your Current Salary as a Healthcare
                  Professional in Germany, along with performance bonuses and additional
                  allowances, allowing you to significantly enhance your financial future.
                </p>
                <div class="benefit-points" aria-label="10x Your Earning Potential highlights">
                  <span><span data-icon="check-circle-2" data-size="13"></span>German salary range</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Allowances + bonuses</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Financial planning</span>
                </div>
                <a href="#process">
                  Get started
                  <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
                </a>
              </div>
              <div class="benefit-media">
                <img
                  alt="Indian nurse reviewing overseas career documents with a Skillcase advisor"
                  src="/assets/images/benefit-earnings.webp"
                />
                <div class="benefit-ui salary-ui" aria-hidden="true">
                  <strong>₹3.2L - ₹3.8L</strong>
                  <div class="salary-bars">
                    <div><small>Current</small><i style="--bar-width: 32%"></i></div>
                    <div><small>Germany</small><i style="--bar-width: 94%"></i></div>
                  </div>
                </div>
              </div>
            </article>

            <article class="benefit-card benefit-card-family">
              <div class="benefit-copy">
                <h3>Settle Abroad with Your Family</h3>
                <p>
                  Germany’s family reunification policy allows you to bring your spouse and
                  minor children with you. They can join you in Germany, and in most cases,
                  also have the right to work during their stay.
                </p>
                <div class="benefit-points" aria-label="Settle Abroad with Your Family highlights">
                  <span><span data-icon="check-circle-2" data-size="13"></span>Spouse support</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Children included</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Work rights guidance</span>
                </div>
                <a href="#process">
                  Get started
                  <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
                </a>
              </div>
              <div class="benefit-media">
                <img
                  alt="Indian healthcare professional with family preparing for relocation to Germany"
                  src="/assets/images/family-settlement.webp"
                />
              </div>
            </article>

            <article class="benefit-card benefit-card-education">
              <div class="benefit-copy">
                <h3>World-Class Healthcare and Education</h3>
                <p>
                  Germany provides free or heavily subsidized healthcare and education for
                  all residents, ensuring your family's well-being and access to quality
                  learning opportunities.
                </p>
                <div class="benefit-points" aria-label="World-Class Healthcare and Education highlights">
                  <span><span data-icon="check-circle-2" data-size="13"></span>Resident healthcare</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Quality education</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Ongoing mentorship</span>
                </div>
                <a href="#process">
                  Get started
                  <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
                </a>
              </div>
              <div class="benefit-media">
                <img
                  alt="Indian nurses in a training and mentorship session"
                  src="/assets/images/benefit-education.webp"
                />
              </div>
            </article>

            <article class="benefit-card benefit-card-residency">
              <div class="benefit-copy">
                <h3>Pathway to Permanent Residency</h3>
                <p>
                  As a healthcare professional in Germany, you can typically apply for
                  permanent residency after 3 years of living and working in the country,
                  provided you meet the language and integration requirements.
                </p>
                <div class="benefit-points" aria-label="Pathway to Permanent Residency highlights">
                  <span><span data-icon="check-circle-2" data-size="13"></span>Document roadmap</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>Language milestones</span>
                  <span><span data-icon="check-circle-2" data-size="13"></span>3-year PR track</span>
                </div>
                <a href="#process">
                  Get started
                  <span data-icon="arrow-right" data-size="14" aria-hidden="true"></span>
                </a>
              </div>
              <div class="benefit-media">
                <img
                  alt="Visa and documentation support for an Indian healthcare professional"
                  src="/assets/images/benefit-residency.webp"
                />
              </div>
            </article>
          </div>
        </section>

        <section class="section webinar-section" id="register-webinar">
          <div class="webinar-card">
            <div class="webinar-copy">
              <a class="webinar-status" href="https://learner.skillcase.in/events/7cdknjvd">
                <span class="webinar-status-icon" aria-hidden="true">
                  <span data-icon="video" data-size="15"></span>
                </span>
                <span>
                  <small>Free live webinar</small>
                  <strong>Nursing jobs in Germany</strong>
                </span>
              </a>
              <h2>Live Webinar - Nursing Jobs In Germany</h2>
              <p class="webinar-lede">
                Join Skillcase experts for a practical walkthrough of eligibility,
                documents, interviews, salary range, and the next steps to work in Germany.
              </p>
              <div class="webinar-details" aria-label="Webinar details">
                <div class="webinar-detail">
                  <span data-icon="video" data-size="17" aria-hidden="true"></span>
                  <span>Live session</span>
                  <strong>Today · 8:00 PM IST</strong>
                </div>
                <div class="webinar-detail">
                  <span data-icon="badge-check" data-size="17" aria-hidden="true"></span>
                  <span>Access</span>
                  <strong>Free registration</strong>
                </div>
                <div class="webinar-detail">
                  <span data-icon="map-pin" data-size="17" aria-hidden="true"></span>
                  <span>Pathway</span>
                  <strong>Nursing jobs in Germany</strong>
                </div>
              </div>
              <div class="webinar-actions">
                <a class="btn btn-gold webinar-primary-cta" href="https://learner.skillcase.in/events/7cdknjvd">
                  Register Now for Free
                  <span data-icon="arrow-right" data-size="16" aria-hidden="true"></span>
                </a>
                <span class="webinar-note">
                  <span data-icon="badge-check" data-size="15" aria-hidden="true"></span>
                  Limited live seats
                </span>
              </div>
            </div>
            <div class="webinar-media">
              <img alt="Indian nurses attending a Germany healthcare webinar" src="/assets/images/webinar-nurses.webp" />
              <div class="webinar-media-topbar" aria-hidden="true">
                <span class="webinar-live-dot"></span>
                Going live tonight
              </div>
              <div class="play-orb" aria-hidden="true">
                <span data-icon="play-filled" data-size="18"></span>
              </div>
            </div>
          </div>
        </section>

        <section class="section apply-section" id="jobs">
          <div class="section-heading">
            <p class="eyebrow">Job seeker?</p>
            <h2>Who can apply?</h2>
            <p>
              Explore diverse job opportunities outside India with expert support at
              every stage—from application to relocation.
            </p>
          </div>
          <div class="job-grid">
            <article class="job-card job-card-jobs">
              <div class="job-card-content">
                <span class="job-badge">
                  <span data-icon="stethoscope" data-size="15" aria-hidden="true"></span>
                  Germany pathway
                </span>
                <h3>Nurses (Jobs)</h3>
                <p>
                  For qualified nurses ready to move into paid clinical roles in
                  Germany with Skillcase support from profile to relocation.
                </p>
                <div class="job-meta">
                  <span><span data-icon="map-pin" data-size="14"></span>Hamburg, Germany</span>
                  <span><span data-icon="briefcase-business" data-size="14"></span>100+ jobs available</span>
                </div>
                <div class="job-card-actions">
                  <button class="btn btn-gold" type="button">Apply Now</button>
                  <small>No recruitment charges</small>
                </div>
              </div>
              <div class="job-visual" aria-hidden="true">
                <img
                  alt=""
                  class="job-cutout job-cutout-jobs"
                  src="/assets/images/job-nurse-jobs.webp"
                />
              </div>
            </article>
            <article class="job-card job-card-ausbildung">
              <div class="job-card-content">
                <span class="job-badge">
                  <span data-icon="graduation-cap" data-size="15" aria-hidden="true"></span>
                  Training pathway
                </span>
                <h3>Nurses (Ausbildung)</h3>
                <p>
                  A guided training route for early-career candidates who want to build
                  a healthcare career in Germany through structured apprenticeship.
                </p>
                <div class="job-meta">
                  <span><span data-icon="map-pin" data-size="14"></span>Hamburg, Germany</span>
                  <span><span data-icon="briefcase-business" data-size="14"></span>50+ jobs available</span>
                </div>
                <div class="job-card-actions">
                  <button class="btn btn-gold" type="button">Apply Now</button>
                  <small>Guided pathway support</small>
                </div>
              </div>
              <div class="job-visual" aria-hidden="true">
                <img
                  alt=""
                  class="job-cutout job-cutout-ausbildung"
                  src="/assets/images/job-nurse-ausbildung.webp"
                />
              </div>
            </article>
          </div>
        </section>

        <section class="section process-section" id="process">
          <div class="process-intro">
            <p class="eyebrow">The Job Search Process</p>
            <h2>Achieve your global career goals with a clear and guided approach every step of the way.</h2>
            <p>
              A Skillcase-led workspace that turns assessment, matching,
              preparation, and relocation into visible next steps.
            </p>
            <div class="process-proof" aria-label="Skillcase process highlights">
              <span>4 guided stages</span>
              <span>Profile-first approach</span>
              <span>Germany pathway</span>
            </div>
          </div>
          <ProcessWorkspace client:load />
        </section>

        <section class="section pathway-section timeline-section">
          <div class="section-heading timeline-heading">
            <p class="eyebrow">Why choose Skillcase?</p>
            <h2>International Job Search Made Easy</h2>
            <p>
              Explore diverse job opportunities outside India with expert support at
              every stage—from application to relocation.
            </p>
          </div>
          <SearchTimeline client:load />
        </section>

        <section class="section testimonials-section">
          <div class="section-heading">
            <p class="eyebrow">Testimonials</p>
            <h2>What our candidates are saying: real stories, real experiences</h2>
          </div>
          <div class="marquee-shell">
            <div class="marquee-row">
              <article class="testimonial-card">
                <span data-icon="badge-check" data-size="20"></span>
                <h3>A Smooth Process</h3>
                <blockquote>I just gave my interview, and I have to say, Skillcase made everything so easy. From the start, they helped me set up my profile and guided me through each step. I’m really excited about what’s coming next and feel confident knowing they’re helping me.</blockquote>
                <p>Priya S.<span>Nurse</span></p>
              </article>
              <article class="testimonial-card">
                <span data-icon="badge-check" data-size="20"></span>
                <h3>Preparing for the Next Step</h3>
                <blockquote>Right now, I’m preparing for my language test and mock interview with Skillcase. They’ve been really supportive in helping me get ready. It feels great to have such a reliable team behind me as I take these important steps towards working abroad.</blockquote>
                <p>Ravi M.<span>Healthcare Worker</span></p>
              </article>
              <article class="testimonial-card">
                <span data-icon="badge-check" data-size="20"></span>
                <h3>Helpful team</h3>
                <blockquote>Skillcase has been really helpful. After my interview, they made sure everything was in order for the next steps. I’m feeling excited about the future and really grateful for all their support. It’s been a great experience so far.</blockquote>
                <p>Anjali K.<span>Nurse</span></p>
              </article>
              <article class="testimonial-card">
                <span data-icon="badge-check" data-size="20"></span>
                <h3>A Smooth Process</h3>
                <blockquote>I just gave my interview, and I have to say, Skillcase made everything so easy. From the start, they helped me set up my profile and guided me through each step. I’m really excited about what’s coming next and feel confident knowing they’re helping me.</blockquote>
                <p>Priya S.<span>Nurse</span></p>
              </article>
              <article class="testimonial-card">
                <span data-icon="badge-check" data-size="20"></span>
                <h3>Preparing for the Next Step</h3>
                <blockquote>Right now, I’m preparing for my language test and mock interview with Skillcase. They’ve been really supportive in helping me get ready. It feels great to have such a reliable team behind me as I take these important steps towards working abroad.</blockquote>
                <p>Ravi M.<span>Healthcare Worker</span></p>
              </article>
              <article class="testimonial-card">
                <span data-icon="badge-check" data-size="20"></span>
                <h3>Helpful team</h3>
                <blockquote>Skillcase has been really helpful. After my interview, they made sure everything was in order for the next steps. I’m feeling excited about the future and really grateful for all their support. It’s been a great experience so far.</blockquote>
                <p>Anjali K.<span>Nurse</span></p>
              </article>
            </div>
          </div>
        </section>

        <section class="section blog-section" id="blogs">
          <div class="section-heading">
            <p class="eyebrow">Blogs</p>
            <h2>Read our blogs</h2>
          </div>
          <div class="blog-grid">
            <article class="blog-card">
              <img alt="" src="/assets/images/blog-opportunity.webp" />
              <div>
                <span>Skillcase</span>
                <h3>Nursing in Germany: A Comprehensive Guide for Aspiring Nurses</h3>
                <p>Germany is a highly sought-after destination for nurses from around the world. With its world-class healthcare system, excellent work-life balance,</p>
                <small>25 July 2025</small>
                <a href="#top">Read more <span data-icon="arrow-right" data-size="14"></span></a>
              </div>
            </article>
            <article class="blog-card">
              <img alt="" src="/assets/images/blog-training.webp" />
              <div>
                <span>Skillcase</span>
                <h3>Nursing Salaries in Germany for Foreign Professionals</h3>
                <p>Germany is a leading destination for nurses worldwide, offering competitive salaries, excellent working conditions, and plenty of opportunities for</p>
                <small>25 July 2025</small>
                <a href="#top">Read more <span data-icon="arrow-right" data-size="14"></span></a>
              </div>
            </article>
            <article class="blog-card">
              <img alt="" src="/assets/images/blog-visa.webp" />
              <div>
                <span>Skillcase</span>
                <h3>Moving to Germany as a Foreign Doctor: A Step-by-Step Guide</h3>
                <p>Germany offers immense opportunities for medical professionals seeking career growth, attractive salaries, and exposure to an advanced healthcare system.</p>
                <small>25 July 2025</small>
                <a href="#top">Read more <span data-icon="arrow-right" data-size="14"></span></a>
              </div>
            </article>
          </div>
        </section>

        <section class="podcast-section">
          <div class="podcast-copy">
            <p class="eyebrow">Podcast</p>
            <h2>Listen to Our Expert Podcast</h2>
            <p>
              Learn about the growing demand for healthcare professionals in Germany, the key
              skills employers seek, and how to stand out in the competitive job market.
            </p>
            <button class="btn btn-gold" type="button">
              Watch more
              <span data-icon="mic-2" data-size="16"></span>
            </button>
          </div>
          <div class="podcast-player">
            <div class="player-cover">
              <span data-icon="sparkles" data-size="22"></span>
              <span>Healthcare situation in Germany</span>
