---
import "../styles/home-b.css";
import { Globe } from "@/components/ui/cobe-globe";

const title = "Skillcase | Healthcare Jobs in Germany";
const description =
  "Skillcase helps Indian healthcare professionals find jobs in Germany with profile guidance, interview preparation, visa documentation, and transparent recruitment support.";

const navItems = [
  { href: "#jobs", label: "Candidate" },
  { href: "/about/", label: "About Us" },
  { href: "/blog/", label: "Blog" },
  { href: "#faq", label: "FAQ" },
];

const services = [
  { icon: "graduation-cap", label: "German language training" },
  { icon: "shield-check", label: "Visa support" },
  { icon: "seal-check", label: "Interview preparation" },
  { icon: "file-text", label: "Documentation review" },
  { icon: "clipboard-text", label: "Profile assessment" },
  { icon: "handshake", label: "Job matching" },
  { icon: "briefcase", label: "CV guidance" },
  { icon: "airplane-takeoff", label: "Relocation planning" },
  { icon: "stethoscope", label: "Employer coordination" },
  { icon: "users-three", label: "Family settlement guidance" },
];

const steps = [
  {
    num: "01",
    icon: "user-circle-check",
    label: "Create your profile",
    summary: "Education, experience, German level and the cities or roles you want.",
    status: "Profile builder",
  },
  {
    num: "02",
    icon: "first-aid",
    label: "Get matched to roles",
    summary: "Skillcase shortlists eligible Germany roles for your level and qualification.",
    status: "Eligible matches",
  },
  {
    num: "03",
    icon: "chats",
    label: "Prepare for interviews",
    summary: "CV polish, mock interviews in German and English, and recruiter-style practice.",
    status: "Coach-led prep",
  },
  {
    num: "04",
    icon: "file-text",
    label: "Documents, visa, move",
    summary: "Anerkennung, embassy, family relocation and the first 30 days in Germany.",
    status: "End-to-end support",
  },
];

const faqs = [
  {
    q: "How do I know if I’m eligible for a particular job?",
    a: "Each job listing on Skillcase includes detailed eligibility criteria. If you're unsure, our team is always available to discuss your qualifications and guide you on the best opportunities.",
  },
  {
    q: "What documents do I need to apply for a job?",
    a: "You'll need your updated resume, professional certifications, language proficiency certificates, and educational qualifications documents. We will guide you through the exact requirements based on the job you apply for.",
  },
  {
    q: "How long does the recruitment process take?",
    a: "The timeline can vary depending on the role and country. For nurses who've completed the language training, it usually takes 2-3 weeks to give your interview and receive an offer letter. You can expect the visa and documentation process to take another 7-8 weeks.",
  },
  {
    q: "What countries can I apply to through Skillcase?",
    a: "Currently, we focus on global opportunities in Germany. We are continuously expanding our reach to bring more opportunities to our candidates.",
  },
];

const testimonials = [
  {
    name: "Nikhil R.",
    role: "Healthcare Candidate · Karnataka",
    avatar: "/assets/images/testimonial-nikhil.webp",
    title: "I knew exactly what to do next",
    quote:
      "Skillcase helped me understand which documents were urgent, what to prepare before calls, and how to keep my application moving without feeling lost.",
  },
  {
    name: "Ravi M.",
    role: "Healthcare Assistant · Maharashtra",
    avatar: "/assets/images/testimonial-ravi.webp",
    title: "Language prep felt structured",
    quote:
      "The team broke my German practice into clear weekly goals and connected it with interview preparation. It finally felt manageable.",
  },
  {
    name: "Anjali K.",
    role: "Staff Nurse · Tamil Nadu",
    avatar: "/assets/images/testimonial-anjali.webp",
    title: "Support after the interview",
    quote:
      "After my interview, Skillcase checked every next requirement with me instead of leaving me confused about documents and timelines.",
  },
  {
    name: "Meera P.",
    role: "Nursing Candidate · Punjab",
    avatar: "/assets/images/testimonial-meera.webp",
    title: "Documents became easier",
    quote:
      "I was worried about missing something important. Their checklist made the application and visa paperwork much easier to track.",
  },
];

const blogs = [
  {
    href: "/blog/nursing-in-germany-guide",
    img: "/assets/images/blog-nursing-germany-guide.webp",
    alt: "Indian healthcare professional researching nursing opportunities in Germany",
    badge: "Career guide",
    date: "2025-07-25",
    dateLabel: "25 July 2025",
    title: "Nursing in Germany: A Comprehensive Guide for Aspiring Nurses",
    excerpt:
      "Germany is a highly sought-after destination for nurses from around the world. With its world-class healthcare system, excellent work-life balance,",
  },
  {
    href: "/blog/nursing-salaries-germany-foreign-professionals",
    img: "/assets/images/blog-salary-germany.webp",
    alt: "Nurse planning salary and career growth for Germany",
    badge: "Salary insights",
    date: "2025-07-25",
    dateLabel: "25 July 2025",
    title: "Nursing Salaries in Germany for Foreign Professionals",
    excerpt:
      "Germany is a leading destination for nurses worldwide, offering competitive salaries, excellent working conditions, and plenty of opportunities for",
  },
  {
    href: "/blog/moving-to-germany-as-a-foreign-doctor",
    img: "/assets/images/blog-doctor-relocation-germany.webp",
    alt: "Foreign medical professional preparing documents for Germany",
    badge: "Relocation",
    date: "2025-07-25",
    dateLabel: "25 July 2025",
    title: "Moving to Germany as a Foreign Doctor: A Step-by-Step Guide",
    excerpt:
      "Germany offers immense opportunities for medical professionals seeking career growth, attractive salaries, and exposure to an advanced healthcare system.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/vendor/phosphor/bold/style.css" />
    <link rel="stylesheet" href="/vendor/phosphor/fill/style.css" />
  </head>
  <body>
    <a class="vb-skip-link" href="#vb-main">Skip to content</a>

    <header class="vb-header" id="vb-header">
      <div class="vb-header-inner">
        <a class="vb-brand" href="/" aria-label="Skillcase home">
          <img alt="Skillcase" src="/assets/images/SKILLCASE_logo_footer.svg" />
        </a>
        <nav class="vb-nav" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="vb-header-actions">
          <a class="vb-login" href="/dashboard/nurse/">Login</a>
          <a class="vb-btn vb-btn-gold vb-btn-sm" href="/signup/">Get Started</a>
          <button
            class="vb-burger"
            type="button"
            aria-controls="vb-mobile-nav"
            aria-expanded="false"
            aria-label="Open navigation menu"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="vb-mobile-nav" id="vb-mobile-nav" aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a href={item.href}>
            {item.label}
            <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
          </a>
        ))}
        <div class="vb-mobile-cta">
          <a class="vb-btn vb-btn-ghost-dark vb-btn-sm" href="/dashboard/nurse/">Login</a>
          <a class="vb-btn vb-btn-gold vb-btn-sm" href="/signup/">Get Started</a>
        </div>
      </nav>
    </header>

    <main id="vb-main">
      <!-- ============ HERO ============ -->
      <section class="vb-hero" id="top">
        <img
          class="vb-hero-bg"
          src="/assets/images/b/hero.jpg"
          alt="Indian nurse at golden hour in Hamburg, Germany"
          fetchpriority="high"
        />
        <div class="vb-hero-shade" aria-hidden="true"></div>
        <div class="vb-hero-grain" aria-hidden="true"></div>
        <div class="vb-container vb-hero-inner">
          <div class="vb-hero-copy">
            <a
              class="vb-live-pill vb-reveal"
              href="https://learner.skillcase.in/events/7cdknjvd"
            >
              <span class="vb-live-dot" aria-hidden="true"></span>
              Live webinar&nbsp;·&nbsp;<strong>Nursing jobs in Germany</strong>
              <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
            </a>
            <h1 class="vb-reveal" style="--d: 80ms">
              Land your healthcare job in <span class="vb-italic">Germany</span>
            </h1>
            <p class="vb-hero-sub vb-reveal" style="--d: 160ms">
              Discover exciting job openings abroad and get the expert help you
              need to navigate the entire process, from application to relocation.
            </p>
            <div class="vb-hero-actions vb-reveal" style="--d: 240ms">
              <a class="vb-btn vb-btn-gold" href="#jobs">
                See Jobs
                <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
              </a>
              <a
                class="vb-btn vb-btn-ghost-dark"
                href="https://learner.skillcase.in/events/7cdknjvd"
              >
                <i class="ph-bold ph-video-camera" aria-hidden="true"></i>
                Join Free Webinar
              </a>
            </div>
          </div>
          <div class="vb-hero-proof vb-reveal" style="--d: 340ms">
            <div class="vb-avatar-stack" aria-hidden="true">
              <img src="/assets/images/testimonial-priya.webp" alt="" loading="lazy" />
              <img src="/assets/images/testimonial-anjali.webp" alt="" loading="lazy" />
              <img src="/assets/images/testimonial-ravi.webp" alt="" loading="lazy" />
              <img src="/assets/images/testimonial-meera.webp" alt="" loading="lazy" />
            </div>
            <div class="vb-proof-item">
              <strong>2,400+ nurses placed</strong>
              <span class="vb-proof-stars" aria-label="Rated 5 out of 5 by candidates">★★★★★</span>
            </div>
            <div class="vb-proof-item">
              <strong>₹0</strong>
              <small>No agent or recruitment charges</small>
            </div>
            <div class="vb-proof-item">
              <strong>End-to-end</strong>
              <small>Application to relocation</small>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ SERVICES MARQUEE ============ -->
      <section class="vb-marquee" aria-label="Skillcase support services">
        <div class="vb-marquee-track">
          {[...services, ...services].map((s) => (
            <span class="vb-marquee-chip">
              <i class={`ph-bold ph-${s.icon}`} aria-hidden="true"></i>
              {s.label}
            </span>
          ))}
        </div>
      </section>

      <!-- ============ OPPORTUNITY STATS ============ -->
      <section class="vb-section vb-stats">
        <div class="vb-container vb-stats-layout">
          <div class="vb-stats-copy vb-reveal">
            <p class="vb-eyebrow">Global opportunities</p>
            <h2 class="vb-h2">India's healthcare talent: ready for global opportunities</h2>
          </div>
          <div class="vb-globe-side vb-reveal" style="--d: 140ms">
            <div class="vb-globe-glow" aria-hidden="true"></div>
            <Globe
              client:visible
              className="vb-globe"
              markers={[
                { id: "india", location: [21.15, 79.09], label: "India" },
                { id: "germany", location: [51.16, 10.45], label: "Germany" },
                { id: "uae", location: [25.2, 55.27], label: "UAE" },
                { id: "uk", location: [51.5, -0.12], label: "UK" },
                { id: "japan", location: [35.68, 139.65], label: "Japan" },
                { id: "australia", location: [-25.27, 133.77], label: "Australia" },
              ]}
              arcs={[
                { id: "in-de", from: [21.15, 79.09], to: [51.16, 10.45], label: "India → Germany" },
              ]}
              markerColor={[0.07, 0.16, 0.27]}
              baseColor={[1, 1, 1]}
              arcColor={[0.85, 0.63, 0.24]}
              glowColor={[0.97, 0.95, 0.9]}
              dark={0}
              mapBrightness={10}
              markerSize={0.05}
              markerElevation={0.01}
              arcWidth={0.6}
              arcHeight={0.32}
              speed={0.0035}
            />
            <p class="vb-globe-caption">
              <i class="ph-bold ph-globe-hemisphere-east" aria-hidden="true"></i>
              Drag the globe — live pathways from India to Germany
            </p>
          </div>
          <div class="vb-stats-main">
            <div class="vb-stats-grid">
              <article class="vb-stat vb-reveal">
                <span class="vb-stat-label">
                  <i class="ph-bold ph-users-three" aria-hidden="true"></i>
                  Healthcare demand
                </span>
                <strong><span data-count="500000">0</span>+</strong>
                <p>Health professionals required in Germany by 2030</p>
              </article>
              <article class="vb-stat vb-reveal" style="--d: 100ms">
                <span class="vb-stat-label">
                  <i class="ph-bold ph-currency-circle-dollar" aria-hidden="true"></i>
                  Average gross salary
                </span>
                <strong>₹3.2&ndash;3.8L</strong>
                <p>Average monthly gross salary for registered nurses in Germany</p>
              </article>
              <article class="vb-stat vb-reveal" style="--d: 200ms">
                <span class="vb-stat-label">
                  <i class="ph-bold ph-shield-check" aria-hidden="true"></i>
                  Transparent support
                </span>
                <strong>Free</strong>
                <p>No agent or recruitment charges, with full transparency</p>
              </article>
            </div>
            <a class="vb-btn vb-btn-gold vb-reveal" style="--d: 120ms" href="/signup/">
              Create Profile
              <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </section>

      <!-- ============ BENEFITS ============ -->
      <section class="vb-section vb-benefits">
        <div class="vb-container">
          <div class="vb-reveal">
            <p class="vb-eyebrow">Why choose Skillcase</p>
            <h2 class="vb-h2">A practical move with long-term upside.</h2>
            <p class="vb-lede">
              Explore the long-term benefits of working in Germany as a healthcare
              professional.
            </p>
          </div>

          <div class="vb-benefit-list">
            <article class="vb-benefit">
              <div class="vb-benefit-media vb-reveal">
                <span class="vb-benefit-num" aria-hidden="true">01</span>
                <img
                  src="/assets/images/b/earnings.jpg"
                  alt="Indian nurse reviewing overseas salary documents with confidence"
                  loading="lazy"
                />
                <div class="vb-salary-card" data-salary aria-hidden="true">
                  <small>Monthly gross salary</small>
                  <strong>₹3.2L &ndash; ₹3.8L</strong>
                  <div class="vb-salary-bars">
                    <div><small>Current</small><i style="--w: 26%"></i></div>
                    <div><small>Germany</small><i style="--w: 94%"></i></div>
                  </div>
                </div>
              </div>
              <div class="vb-benefit-copy vb-reveal" style="--d: 140ms">
                <h3>10x your earning potential</h3>
                <p>
                  Earn up to 10 times more than your current salary as a healthcare
                  professional in Germany, along with performance bonuses and additional
                  allowances, allowing you to significantly enhance your financial future.
                </p>
                <div class="vb-benefit-points" aria-label="Earning potential highlights">
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>German salary range</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Allowances + bonuses</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Financial planning</span>
                </div>
                <a class="vb-textlink" href="#pathway">
                  Get started
                  <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>

            <article class="vb-benefit">
              <div class="vb-benefit-media vb-reveal">
                <span class="vb-benefit-num" aria-hidden="true">02</span>
                <img
                  src="/assets/images/b/family.jpg"
                  alt="Indian healthcare professional walking with family in a German park"
                  loading="lazy"
                />
              </div>
              <div class="vb-benefit-copy vb-reveal" style="--d: 140ms">
                <h3>Settle abroad with your family</h3>
                <p>
                  Germany’s family reunification policy allows you to bring your spouse and
                  minor children with you. They can join you in Germany, and in most cases,
                  also have the right to work during their stay.
                </p>
                <div class="vb-benefit-points" aria-label="Family settlement highlights">
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Spouse support</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Children included</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Work rights guidance</span>
                </div>
                <a class="vb-textlink" href="#pathway">
                  Get started
                  <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>

            <article class="vb-benefit">
              <div class="vb-benefit-media vb-reveal">
                <span class="vb-benefit-num" aria-hidden="true">03</span>
                <img
                  src="/assets/images/b/education.jpg"
                  alt="Indian nurses in a training and mentorship session in a German teaching hospital"
                  loading="lazy"
                />
              </div>
              <div class="vb-benefit-copy vb-reveal" style="--d: 140ms">
                <h3>World-class healthcare and education</h3>
                <p>
                  Germany provides free or heavily subsidized healthcare and education for
                  all residents, ensuring your family's well-being and access to quality
                  learning opportunities.
                </p>
                <div class="vb-benefit-points" aria-label="Healthcare and education highlights">
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Resident healthcare</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Quality education</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Ongoing mentorship</span>
                </div>
                <a class="vb-textlink" href="#pathway">
                  Get started
                  <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>

            <article class="vb-benefit">
              <div class="vb-benefit-media vb-reveal">
                <span class="vb-benefit-num" aria-hidden="true">04</span>
                <img
                  src="/assets/images/b/residency.jpg"
                  alt="German residence permit and visa documents arranged on a desk"
                  loading="lazy"
                />
              </div>
              <div class="vb-benefit-copy vb-reveal" style="--d: 140ms">
                <h3>Pathway to permanent residency</h3>
                <p>
                  As a healthcare professional in Germany, you can typically apply for
                  permanent residency after 3 years of living and working in the country,
                  provided you meet the language and integration requirements.
                </p>
                <div class="vb-benefit-points" aria-label="Permanent residency highlights">
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Document roadmap</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>Language milestones</span>
                  <span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>3-year PR track</span>
                </div>
                <a class="vb-textlink" href="#pathway">
                  Get started
                  <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ PATHWAY ============ -->
      <section class="vb-section vb-path" id="pathway">
        <div class="vb-container vb-path-grid">
          <div class="vb-path-intro vb-reveal">
            <p class="vb-eyebrow">Why choose Skillcase</p>
            <h2 class="vb-h2">International nursing jobs, made step by step.</h2>
            <p class="vb-lede">
              One coach, one path. Profile to relocation, every stage tracked inside
              your Skillcase dashboard. No agent fees, no guesswork.
            </p>
            <div class="vb-path-chips" aria-label="Skillcase pathway highlights">
              <span>4 guided stages</span>
              <span>2,400+ nurses placed</span>
              <span>Zero recruitment fees</span>
            </div>
            <a class="vb-btn vb-btn-gold" href="/signup/">
              Create your profile
              <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
          <ol class="vb-path-steps" data-path>
            <div class="vb-path-progress" data-path-progress aria-hidden="true"></div>
            {steps.map((step, idx) => (
              <li class="vb-step vb-reveal" style={`--d: ${idx * 90}ms`}>
                <div class="vb-step-top">
                  <span class="vb-step-icon" aria-hidden="true">
                    <i class={`ph-bold ph-${step.icon}`}></i>
                  </span>
                  <span class="vb-step-num">Step {step.num}</span>
                  <span class="vb-step-status">{step.status}</span>
                </div>
                <h3>{step.label}</h3>
                <p>{step.summary}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ============ WHO CAN APPLY ============ -->
      <section class="vb-section vb-jobs" id="jobs">
        <div class="vb-container">
          <div class="vb-jobs-head">
            <div class="vb-reveal">
              <p class="vb-eyebrow">Job seeker?</p>
              <h2 class="vb-h2">Who can apply?</h2>
              <p class="vb-lede">
                Explore diverse job opportunities outside India with expert support at
                every stage—from application to relocation.
              </p>
            </div>
          </div>
          <div class="vb-jobs-grid">
            <article class="vb-job-card vb-reveal">
              <div class="vb-job-body">
                <span class="vb-job-badge">
                  <i class="ph-bold ph-stethoscope" aria-hidden="true"></i>
                  Germany pathway
                </span>
                <h3>Nurses (Jobs)</h3>
                <p>
                  For qualified nurses ready to move into paid clinical roles in Germany
                  with Skillcase support from profile to relocation.
                </p>
                <div class="vb-job-meta">
                  <span><i class="ph-bold ph-map-pin" aria-hidden="true"></i>Hamburg, Germany</span>
                  <span><i class="ph-bold ph-briefcase" aria-hidden="true"></i>100+ jobs available</span>
                </div>
                <div class="vb-job-cta">
                  <a class="vb-btn vb-btn-gold vb-btn-sm" href="/signup/">
                    Apply Now
                    <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
                  </a>
                  <small>No recruitment charges</small>
                </div>
              </div>
              <div class="vb-job-media" aria-hidden="true">
                <img src="/assets/images/b/jobnurse.jpg" alt="" loading="lazy" />
              </div>
            </article>

            <article class="vb-job-card vb-reveal" style="--d: 140ms">
              <div class="vb-job-body">
                <span class="vb-job-badge">
                  <i class="ph-bold ph-graduation-cap" aria-hidden="true"></i>
                  Training pathway
                </span>
                <h3>Nurses (Ausbildung)</h3>
                <p>
                  A guided training route for early-career candidates who want to build a
                  healthcare career in Germany through structured apprenticeship.
                </p>
                <div class="vb-job-meta">
                  <span><i class="ph-bold ph-map-pin" aria-hidden="true"></i>Hamburg, Germany</span>
                  <span><i class="ph-bold ph-briefcase" aria-hidden="true"></i>50+ jobs available</span>
                </div>
                <div class="vb-job-cta">
                  <a class="vb-btn vb-btn-gold vb-btn-sm" href="/signup/">
                    Apply Now
                    <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
                  </a>
                  <small>Guided pathway support</small>
                </div>
              </div>
              <div class="vb-job-media" aria-hidden="true">
