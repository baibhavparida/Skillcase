        <div class="vb-footer-bottom">
          <p>© 2026 Skillcase All Rights Reserved.</p>
          <div>
            <a href="/terms-and-condition/">Terms &amp; Conditions</a>
            <a href="/privacy-policy/">Privacy Policy</a>
          </div>
        </div>
      </div>
    </footer>

    <span class="vb-variant-tag" aria-hidden="true">Variant B</span>

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Sticky header state
      const header = document.getElementById("vb-header");
      const onScrollHeader = () => {
        header?.classList.toggle("is-scrolled", window.scrollY > 24);
      };
      onScrollHeader();
      window.addEventListener("scroll", onScrollHeader, { passive: true });

      // Mobile nav
      const burger = document.querySelector(".vb-burger");
      const mobileNav = document.getElementById("vb-mobile-nav");
      burger?.addEventListener("click", () => {
        const open = burger.getAttribute("aria-expanded") === "true";
        burger.setAttribute("aria-expanded", String(!open));
        burger.setAttribute("aria-label", open ? "Open navigation menu" : "Close navigation menu");
        mobileNav?.classList.toggle("is-open", !open);
        header?.classList.add("is-scrolled");
      });
      mobileNav?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          burger?.setAttribute("aria-expanded", "false");
          mobileNav.classList.remove("is-open");
        })
      );

      // Scroll reveals
      const revealEls = document.querySelectorAll(".vb-reveal");
      if (reduceMotion) {
        revealEls.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Count-up stats
      const formatCount = (n: number) => n.toLocaleString("en-IN");
      document.querySelectorAll("[data-count]").forEach((el) => {
        const target = Number(el.getAttribute("data-count"));
        if (reduceMotion) {
          el.textContent = formatCount(target);
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            if (!entries[0].isIntersecting) return;
            io.disconnect();
            const start = performance.now();
            const dur = 1600;
            const tick = (now: number) => {
              const p = Math.min((now - start) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 4);
              el.textContent = formatCount(Math.round(target * eased));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          },
          { threshold: 0.5 }
        );
        io.observe(el);
      });

      // Salary bars
      const salaryCard = document.querySelector("[data-salary]");
      if (salaryCard) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              salaryCard.classList.add("is-in");
              io.disconnect();
            }
          },
          { threshold: 0.6 }
        );
        io.observe(salaryCard);
      }

      // Workspace feature cycle
      const wsGrid = document.querySelector("[data-ws]");
      if (wsGrid) {
        const wsItems = Array.from(wsGrid.querySelectorAll<HTMLElement>(".vb-ws-item"));
        const wsPanels = Array.from(wsGrid.querySelectorAll<HTMLElement>(".vb-ws-panel"));
        let wsCurrent = 0;
        const wsSelect = (idx: number) => {
          wsCurrent = idx;
          wsItems.forEach((item, i) => {
            const active = i === idx;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-selected", String(active));
            item.tabIndex = active ? 0 : -1;
          });
          wsPanels.forEach((panel, i) => {
            panel.classList.toggle("is-active", i === idx);
            panel.setAttribute("aria-hidden", String(i !== idx));
          });
        };
        wsItems.forEach((item, idx) => {
          item.addEventListener("click", () => {
            wsGrid.classList.add("is-manual");
            wsSelect(idx);
          });
          item.addEventListener("keydown", (e) => {
            let next: number | null = null;
            if (e.key === "ArrowDown" || e.key === "ArrowRight") next = (idx + 1) % wsItems.length;
            if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = (idx - 1 + wsItems.length) % wsItems.length;
            if (next !== null) {
              e.preventDefault();
              wsGrid.classList.add("is-manual");
              wsSelect(next);
              wsItems[next].focus();
            }
          });
          item.querySelector(".vb-ws-item-progress")?.addEventListener("animationend", () => {
            if (!wsGrid.classList.contains("is-manual")) wsSelect((wsCurrent + 1) % wsItems.length);
          });
        });
        new IntersectionObserver(
          (entries) => {
            wsGrid.classList.toggle("is-live", entries[0].isIntersecting);
          },
          { threshold: 0.25 }
        ).observe(wsGrid);
      }

      // Pathway progress line
      const pathList = document.querySelector("[data-path]");
      const pathProgress = document.querySelector<HTMLElement>("[data-path-progress]");
      const pathSteps = Array.from(document.querySelectorAll(".vb-step"));
      if (pathList && pathProgress) {
        const onScrollPath = () => {
          const rect = pathList.getBoundingClientRect();
          const viewportMid = window.innerHeight * 0.6;
          const total = rect.height - 16;
          const passed = Math.min(Math.max(viewportMid - rect.top, 0), total);
          pathProgress.style.height = `${passed}px`;
          pathSteps.forEach((step) => {
            const sRect = step.getBoundingClientRect();
            step.classList.toggle("is-passed", sRect.top + 40 < viewportMid);
          });
        };
        onScrollPath();
        window.addEventListener("scroll", onScrollPath, { passive: true });
      }

      // FAQ accordion
      document.querySelectorAll(".vb-faq-item").forEach((item) => {
        const btn = item.querySelector<HTMLElement>(".vb-faq-q");
        const answer = item.querySelector<HTMLElement>(".vb-faq-a");
        if (!btn || !answer) return;
        if (item.classList.contains("is-open")) {
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
        btn.addEventListener("click", () => {
          const isOpen = item.classList.contains("is-open");
          document.querySelectorAll(".vb-faq-item.is-open").forEach((other) => {
            if (other !== item) {
              other.classList.remove("is-open");
              other.querySelector(".vb-faq-q")?.setAttribute("aria-expanded", "false");
              const otherAnswer = other.querySelector<HTMLElement>(".vb-faq-a");
              if (otherAnswer) otherAnswer.style.maxHeight = "0px";
            }
          });
          item.classList.toggle("is-open", !isOpen);
          btn.setAttribute("aria-expanded", String(!isOpen));
          answer.style.maxHeight = isOpen ? "0px" : answer.scrollHeight + "px";
        });
      });
    </script>
  </body>
</html>
